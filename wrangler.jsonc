{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "plan-decoder-1",
  "compatibility_date": "2026-08-22",
  "compatibility_flags": ["nodejs_compat"],
  "main": "@tanstack/react-start/server-entry",
  "preview_urls": true,
  "workers_dev": true,
  "placement": { "mode": "smart" },
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "invocation_logs": true,
      "head_sampling_rate": 1
    }
  },
  "vars": {
    "VITE_AUTH_ENABLED": "true",
    "BETTER_AUTH_URL": "https://www.plandecoder.com",
    "BETTER_AUTH_SECRET": "6QlTApcnZ03wf21gaC1x2HBL7siJNzTOudQnYFssxaBcCrmjjxLHydjvwXakop_1"
  },
  "routes": [
    { "pattern": "plandecoder.com", "custom_domain": true },
    { "pattern": "www.plandecoder.com", "custom_domain": true }
  }
}
